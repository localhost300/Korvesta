# Generate a long random value, for example: openssl rand -base64 48
KORVESTA_SESSION_SECRET=

# Temporary single-user access. Replace this adapter with your identity provider
# before onboarding real customers or staff.
KORVESTA_CUSTOMER_EMAIL=
KORVESTA_CUSTOMER_PASSWORD=
KORVESTA_ADMIN_EMAIL=
KORVESTA_ADMIN_PASSWORD=

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PAYMENT_DATA_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transactional account emails. EMAIL_FROM must use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Korvesta <notifications@example.com>
EMAIL_REPLY_TO=support@example.com
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_KEY=
ENABLE_LIVE_EXECUTION=false
# Required in addition to ENABLE_LIVE_EXECUTION before real-money Binance orders can be sent.
ALLOW_BINANCE_MAINNET=
# Shared secret for the external paper limit-order processor/cron endpoint.
TRADING_CRON_SECRET=
# Separate secret for the daily fixed-APY accrual endpoint.
INVESTMENT_CRON_SECRET=
# Emergency switch. Set true to reject every new Binance order immediately.
TRADING_EMERGENCY_STOP=false
# Per-order notional cap enforced before Binance submission.
MAX_LIVE_ORDER_NOTIONAL_USDT=1000
